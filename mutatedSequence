#!/usr/bin/env bash
# Thin launcher for the Python package.  Examples:
#   ./mutatedSequence --help
#   ./mutatedSequence run -g genome.fa -a annotation.gtf -v sample.vcf -o out
#   ./mutatedSequence diagnose -g genome.fa -a annotation.gtf -v sample.vcf -o diag
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="${DIR}${PYTHONPATH:+:${PYTHONPATH}}"
exec python -m mutatedseq "$@"
